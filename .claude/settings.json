{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(git status*)",
			"Bash(git diff*)",
			"Bash(git log*)",
			"Bash(git show*)",
			"Bash(git branch)",
			"Bash(git branch --list*)",
			"Bash(git branch -a*)",
			"Bash(git branch --show-current)",
			"Bash(git remote -v)",
			"Bash(ls)",
			"Bash(ls *)",
			"Bash(tree*)",
			"Bash(rg *)",
			"Bash(wc *)",
			"Bash(gh pr view*)",
			"Bash(gh pr list*)",
			"Bash(gh pr diff*)",
			"Bash(gh issue view*)",
			"Bash(gh issue list*)",
			"Bash(git commit*)"
		],
		"deny": [
			"Bash(git push*)",
			"Bash(gh pr create*)",
			"Bash(gh pr merge*)",
			"Bash(npm publish*)",
			"Read(./.env)",
			"Read(./.env.*)",
			"Read(**/.env)",
			"Read(**/.env.*)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Read(**/id_rsa*)",
			"Read(**/credentials.json)",
			"Read(**/secrets.*)",
			"Edit(**/.env)",
			"Edit(**/.env.*)",
			"Bash(rm -rf /*)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git push * --force*)",
			"Bash(git push * -f*)",
			"Bash(curl * | bash*)",
			"Bash(curl * | sh*)",
			"Bash(wget * | bash*)",
			"Bash(wget * | sh*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/scan-commit/scan-commit.sh",
						"timeout": 10
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash -c 'CMD=$(cat | jq -r \".tool_input.command // empty\"); if echo \"$CMD\" | grep -qEi \"(^|[&|;(])[[:space:]]*git[[:space:]]+push[[:space:]]+.*\\b(main|master|production)([[:space:];|&)]|$)\"; then echo \"BLOCKED: Direct push to protected branch. Use a feature branch and PR.\" >&2; exit 2; fi'"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash -c 'CMD=$(cat | jq -r \".tool_input.command // empty\"); if echo \"$CMD\" | grep -qEi \"curl\\s.*\\|\\s*(bash|sh|zsh)|wget\\s.*\\|\\s*(bash|sh|zsh)\"; then echo \"BLOCKED: Pipe-to-shell detected. Download first, inspect, then execute.\" >&2; exit 2; fi'"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bash -c 'CMD=$(cat | jq -r \".tool_input.command // empty\"); if echo \"$CMD\" | grep -qEi \"rm\\s+-(r|f|rf|fr)\\s+(/|~|\\$HOME)\"; then echo \"BLOCKED: Destructive delete. Use trash or move to tmp instead.\" >&2; exit 2; fi'"
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "~/.claude/hooks/scan-secrets/scan-secrets.sh",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{
						"type": "command",
						"command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/format-on-edit/format-on-edit.sh"
					}
				]
			}
		]
	}
}
